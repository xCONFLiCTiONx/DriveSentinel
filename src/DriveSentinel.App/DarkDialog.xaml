<Window x:Class="DriveSentinel.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveSentinel"
        Width="440" MaxWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#0F141D"
        Foreground="#EDF2FA">
  <Border Background="#121824" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="8" Padding="20">
    <StackPanel>
      <!-- Title -->
      <TextBlock x:Name="TitleText" Text="DriveSentinel" FontSize="16" FontWeight="Bold" Foreground="#EDF2FA" Margin="0,0,0,12"/>
      
      <!-- Message -->
      <TextBlock x:Name="MessageText" Text="Message" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="#CBD5E1" Margin="0,0,0,20"/>
      
      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Background="#222C3D" BorderBrush="#35445C" Foreground="#EDF2FA" Padding="14,6" Margin="0,0,8,0" MinWidth="80" Cursor="Hand"/>
        <Button x:Name="ConfirmButton" Content="OK" Click="ConfirmButton_Click" Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#EDF2FA" FontWeight="SemiBold" Padding="14,6" MinWidth="80" Cursor="Hand"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

