<Window x:Class="DriveSentinel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — DriveSentinel" Height="430" Width="560" MinHeight="360" MinWidth="480"
        Background="#10151E" Foreground="#EDF2FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#1B2230" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
      <TextBlock Text="DriveSentinel Settings" FontSize="18" FontWeight="Bold"/>
    </Border>

    <!-- Settings Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
      <StackPanel>
        
        <!-- Section 1: Monitoring & Alerts -->
        <Border Background="#161F2E" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Monitoring &amp; Alerts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Check Interval" FontWeight="Medium" VerticalAlignment="Center"/>
              <ComboBox x:Name="IntervalCombo" Width="150" HorizontalAlignment="Right">
                <ComboBoxItem Content="Every 5 minutes" Tag="5"/>
                <ComboBoxItem Content="Every 10 minutes" Tag="10"/>
                <ComboBoxItem Content="Every 15 minutes (Default)" Tag="15"/>
                <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                <ComboBoxItem Content="Every 60 minutes" Tag="60"/>
              </ComboBox>
            </DockPanel>

            <CheckBox x:Name="PredictiveAlertsCheck" Content="Enable failure alerts" Margin="0,0,0,8" FontWeight="Medium" IsChecked="True"/>
            <CheckBox x:Name="TrayNotificationsCheck" Content="Show system tray desktop notifications" FontWeight="Medium" IsChecked="True"/>
          </StackPanel>
        </Border>

        <!-- Section 2: Alert Thresholds -->
        <Border Background="#161F2E" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Alert Thresholds" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Temperature Warning Threshold" FontWeight="Medium" VerticalAlignment="Center"/>
              <ComboBox x:Name="TempCombo" Width="150" HorizontalAlignment="Right">
                <ComboBoxItem Content="55°C" Tag="55"/>
                <ComboBoxItem Content="60°C" Tag="60"/>
                <ComboBoxItem Content="65°C (Default)" Tag="65"/>
                <ComboBoxItem Content="70°C" Tag="70"/>
              </ComboBox>
            </DockPanel>

            <DockPanel>
              <TextBlock Text="Low Free Space Warning" FontWeight="Medium" VerticalAlignment="Center"/>
              <ComboBox x:Name="SpaceCombo" Width="150" HorizontalAlignment="Right">
                <ComboBoxItem Content="5% free" Tag="5"/>
                <ComboBoxItem Content="10% free (Default)" Tag="10"/>
                <ComboBoxItem Content="15% free" Tag="15"/>
                <ComboBoxItem Content="20% free" Tag="20"/>
              </ComboBox>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Section 3: Windows Startup -->
        <Border Background="#161F2E" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="8" Padding="14">
          <StackPanel>
            <TextBlock Text="Windows Startup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- Current Status Box -->
            <Border x:Name="StartupStatusBox" Background="#101826" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
              <DockPanel>
                <TextBlock x:Name="StartupStatusIcon" Text="🟢" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="StartupStatusHeading" Text="Registered to start with Windows" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1"/>
                  <TextBlock x:Name="StartupStatusDetails" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Simple CheckBox Toggle -->
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start DriveSentinel with Windows" Click="StartWithWindowsCheck_Click" FontWeight="Medium"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Actions -->
    <DockPanel Grid.Row="2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save settings" Click="Save_Click" Background="#065F46" BorderBrush="#10B981" FontWeight="SemiBold"/>
        <Button Content="Cancel" Click="Cancel_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
