<Window x:Class="DriveSentinel.DriveStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Health &amp; Diagnostics — DriveSentinel" Height="630" Width="980" MinHeight="460" MinWidth="750"
        Background="#10151E" Foreground="#EDF2FA" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#273247"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#3B4A62"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#10151E"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Background" Value="#202A3A"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabBorder"
                    Background="#202A3A"
                    BorderBrush="#303C50"
                    BorderThickness="1,1,1,0"
                    CornerRadius="6,6,0,0"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#171E2A"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4F8CFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#29364A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF2FA"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="#202A3A"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#3B4A62"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#171E2A"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#303C50"/>
      <Setter Property="RowBackground" Value="#171E2A"/>
      <Setter Property="AlternatingRowBackground" Value="#1C2534"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#2A3547"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Top Drive Header -->
    <Border Grid.Row="0" Background="#1B2230" BorderBrush="#303C50" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="DriveTitle" Text="Physical Drive" FontSize="22" FontWeight="Bold"/>
            <Border x:Name="BusTypeBadge" Background="#26354D" CornerRadius="4" Padding="8,2" Margin="12,2,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="BusTypeText" Text="NVMe SSD" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
            </Border>
          </DockPanel>
          <TextBlock x:Name="DriveSubtitle" Text="Serial Number: — · Capacity: — · Volumes: —" Foreground="#AAB5C5" Margin="0,5,0,0"/>
          <TextBlock x:Name="CollectedText" Foreground="#8F9DB2" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="CopyReportButton" Content="Copy report" Click="CopyReport_Click"/>
          <Button x:Name="RefreshStatusButton" Content="Refresh" Click="RefreshStatus_Click"/>
          <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Early Failure Prediction & Health Banner -->
    <Border Grid.Row="1" x:Name="PredictionBanner" Background="#162722" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Health Score Circle -->
        <Border Background="#101820" CornerRadius="12" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Width="105">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="HEALTH" FontSize="10" FontWeight="Bold" Foreground="#8F9DB2" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HealthScoreNumber" Text="100%" FontSize="26" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,2"/>
            <TextBlock x:Name="HealthScoreStatus" Text="HEALTHY" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Prediction Details -->
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <DockPanel>
            <Border x:Name="PredictionBadgeBorder" Background="#22C55E" CornerRadius="4" Padding="8,4">
              <TextBlock x:Name="PredictionBadgeText" Text="HEALTHY — NO FAILURE PREDICTED" FontWeight="Bold" FontSize="12" Foreground="#0A1E14"/>
            </Border>
            <TextBlock x:Name="PredictionNoticeTime" Foreground="#AAB5C5" FontSize="12" Margin="12,4,0,0"/>
          </DockPanel>

          <TextBlock x:Name="PredictionSummaryText" Text="No early failure indicators detected. Drive is operating within safe parameters." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="PredictionActionText" Text="Action: No action required. Drive is in good health." Foreground="#8DE0B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
          
          <ItemsControl x:Name="RiskFactorsList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock Text="⚠️ " Foreground="#F97316"/>
                  <TextBlock Text="{Binding}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Tabs -->
    <TabControl Grid.Row="2" Background="#10151E" Foreground="#EDF2FA" BorderBrush="#303C50">
      
      <!-- Tab 1: Key Stats & SMART / NVMe Attributes -->
      <TabItem Header="Real SMART &amp; health stats">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Key Metrics Cards -->
          <UniformGrid Rows="1" Margin="0,0,0,12">
            
            <Border Background="#171E2A" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Temperature" Foreground="#8F9DB2" FontSize="11"/>
                <TextBlock x:Name="MetricTemp" Text="—" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="#171E2A" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Remaining Endurance" Foreground="#8F9DB2" FontSize="11"/>
                <TextBlock x:Name="MetricWear" Text="—" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="#171E2A" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Available Spare" Foreground="#8F9DB2" FontSize="11"/>
                <TextBlock x:Name="MetricSpare" Text="—" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="#171E2A" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Power-On Hours" Foreground="#8F9DB2" FontSize="11"/>
                <TextBlock x:Name="MetricHours" Text="—" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="#171E2A" BorderBrush="#303C50" BorderThickness="1" CornerRadius="8" Padding="10">
              <StackPanel>
                <TextBlock Text="Bad Sectors / Media Errors" Foreground="#8F9DB2" FontSize="11"/>
                <TextBlock x:Name="MetricBadSectors" Text="0" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

          </UniformGrid>

          <!-- Attributes DataGrid -->
          <DataGrid x:Name="AttributesGrid" Grid.Row="1" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
              <DataGridTextColumn Header="SMART Attribute / NVMe Metric" Binding="{Binding Name}" Width="*"/>
              <DataGridTemplateColumn Header="Status" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="75"/>
              <DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="75"/>
              <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="85"/>
              <DataGridTextColumn Header="Raw Value" Binding="{Binding RawDisplay}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Tab 2: Windows Storage Events -->
      <TabItem Header="Correlated storage events">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DataGrid x:Name="EventsGrid" Grid.Row="1" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140"/>
              <DataGridTemplateColumn Header="Level" Width="85">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
              <DataGridTextColumn Header="Event ID" Binding="{Binding Id}" Width="70"/>
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Tab 3: Drive Specifications -->
      <TabItem Header="Device identity &amp; details">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
          <StackPanel>
            <TextBlock Text="Hardware Specifications" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SpecModel" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SpecSerial" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Bus Interface" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SpecBus" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Media Type" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SpecMedia" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Physical Capacity" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SpecCapacity" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Mounted Volumes" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SpecVolumes" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="6" Grid.Column="0" Text="Total Bytes Written (TBW)" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SpecTbw" Text="—" FontWeight="Medium"/>

              <TextBlock Grid.Row="7" Grid.Column="0" Text="Power Cycles" Foreground="#8F9DB2"/>
              <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SpecCycles" Text="—" FontWeight="Medium"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
