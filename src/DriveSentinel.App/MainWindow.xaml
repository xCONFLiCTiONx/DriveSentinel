<Window x:Class="DriveSentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveSentinel — Hardware Drive Health"
        Icon="/DriveSentinel;component/Assets/icon.ico" Height="680" Width="1100" MinHeight="500" MinWidth="850"
        Background="#0F141D" Foreground="#EDF2FA" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#222C3D"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#35445C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#0F141D"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Background" Value="#1A2230"/>
      <Setter Property="Foreground" Value="#AAB5C5"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabBorder"
                    Background="#1A2230"
                    BorderBrush="#2B374A"
                    BorderThickness="1,1,1,0"
                    CornerRadius="6,6,0,0"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#141C28"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#243044"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="#1A2230"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="BorderBrush" Value="#2E3C52"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#141C28"/>
      <Setter Property="Foreground" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#2B374A"/>
      <Setter Property="RowBackground" Value="#141C28"/>
      <Setter Property="AlternatingRowBackground" Value="#182333"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#243144"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="130" MinHeight="70"/>
    </Grid.RowDefinitions>

    <!-- Top Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Title -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="DriveSentinel" FontSize="22" FontWeight="Bold"/>
      </StackPanel>

      <!-- Center: Status message badge -->
      <Border Grid.Column="1" x:Name="SystemStatusBadge" Background="#142C21" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock x:Name="SystemStatusIcon" Text="🟢" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="SystemStatusText" Text="ALL DRIVES HEALTHY" Foreground="#4ADE80" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- Right: Action Buttons -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button Content="Refresh telemetry" Click="Refresh_Click" Background="#1E3A8A" BorderBrush="#3B82F6"/>
        <Button Content="View drive details" Click="ViewDetails_Click" Background="#065F46" BorderBrush="#10B981"/>
        <Button Content="Settings" Click="Settings_Click" Background="#243044" BorderBrush="#3A4D6B" Margin="0"/>
      </StackPanel>
    </Grid>

    <!-- Main Content Tabs -->
    <TabControl Grid.Row="1" Background="#0F141D" Foreground="#EDF2FA" BorderBrush="#2B374A">
      
      <!-- Tab 1: Hardware Physical Drives (Primary!) -->
      <TabItem Header="Physical drives &amp; SMART health">
        <Grid Margin="6">
          <DataGrid x:Name="PhysicalDrivesGrid" AlternationCount="2" SelectionChanged="PhysicalDrivesGrid_SelectionChanged" MouseDoubleClick="PhysicalDrivesGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Disk" Binding="{Binding DiskIndex}" Width="50"/>
              <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*"/>
              <DataGridTextColumn Header="Bus / Media" Binding="{Binding MediaType}" Width="120"/>
              <DataGridTextColumn Header="Volumes" Binding="{Binding VolumesSummary}" Width="140"/>
              <DataGridTemplateColumn Header="Health Score" Width="105">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding HealthScoreLabel}" Foreground="{Binding HealthScoreBrush}" FontWeight="Bold"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Failure Prediction" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <Border Background="{Binding Prediction.BadgeBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Prediction.BadgeText}" FontWeight="Bold" FontSize="10" Foreground="{Binding Prediction.BadgeForeground}"/>
                      </Border>
                      <TextBlock Text="{Binding Prediction.Summary}" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Temp" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding TemperatureLabel}" Foreground="{Binding TemperatureBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Life Left" Binding="{Binding LifeRemainingLabel}" Width="120"/>
              <DataGridTextColumn Header="Power-On Time" Binding="{Binding PowerOnHoursLabel}" Width="120"/>
              <DataGridTextColumn Header="Risk Factors" Binding="{Binding KeyRiskSummary}" Width="180"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Tab 2: Logical Volumes & Free Space -->
      <TabItem Header="Logical volumes &amp; space">
        <Grid Margin="6">
          <DataGrid x:Name="VolumesGrid" AlternationCount="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="80"/>
              <DataGridTextColumn Header="Volume Label" Binding="{Binding Label}" Width="2*"/>
              <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120"/>
              <DataGridTextColumn Header="Capacity" Binding="{Binding CapacityLabel}" Width="110"/>
              <DataGridTextColumn Header="Free Space" Binding="{Binding FreeLabel}" Width="110"/>
              <DataGridTextColumn Header="File System" Binding="{Binding FileSystem}" Width="100"/>
              <DataGridCheckBoxColumn Header="Watch" Binding="{Binding IsWatched, Mode=OneWay}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Toolbar Under Grid -->
    <DockPanel Grid.Row="2" Margin="0,10,0,8">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="View Full Health &amp; SMART Details" Click="ViewDetails_Click" Background="#065F46" BorderBrush="#10B981"/>
        <Button Content="Watch Volume" Click="WatchVolume_Click"/>
        <Button Content="Stop Watching Volume" Click="UnwatchVolume_Click"/>
        <Button Content="Manual File-System Check" Click="Scan_Click" Background="#1E293B" BorderBrush="#334155"/>
      </StackPanel>
      <TextBlock x:Name="DriveCountText" DockPanel.Dock="Right" Foreground="#94A3B8" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Bottom Log Panel -->
    <Border Grid.Row="3" Background="#141C28" BorderBrush="#2B374A" BorderThickness="1" CornerRadius="10" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="Activity &amp; Telemetry Log" FontWeight="SemiBold" FontSize="13" Foreground="#CBD5E1"/>
          <TextBlock x:Name="LastRefreshText" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11"/>
        </DockPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" Background="#0B1017" Foreground="#CBD5E1" BorderBrush="#243144"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" FontSize="11" AcceptsReturn="True"/>
      </Grid>
    </Border>
  </Grid>
</Window>
