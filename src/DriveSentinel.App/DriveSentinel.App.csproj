<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icons\icon.ico</ApplicationIcon>
    <AssemblyName>DriveSentinel</AssemblyName>
    <RootNamespace>DriveSentinel</RootNamespace>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\icons\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\..\icons\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>
</Project>
